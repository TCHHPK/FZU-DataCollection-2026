    "def hello():\n",
    "    return \"你好\"\n",
    " \n",
    "@app.route(\"/hi\")\n",
    "def hi():\n",
    "    return \"Hi,你好\"\n",
    " \n",
    "if __name__==\"__main__\":#Python 标准用法，用于判断当前脚本是否作为主程序运行。\n",
